# ============================================================
# Themis RAG — template konfigurasi
# Salin file ini menjadi .env lalu isi nilainya:
#   Windows : copy .env.example .env
#   macOS/Linux: cp .env.example .env
# JANGAN pernah commit .env ke version control.
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
# Provider utama: qwen | gemini | openrouter | ollama
LLM_PROVIDER=qwen

# Qwen via LiteLLM Proxy (default)
QWEN_BASE_URL=https://aicon.air.id/
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3.8-27B

# Google Gemini (cadangan)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (cadangan)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Ollama lokal (tidak butuh API key)
OLLAMA_MODEL=qwen2.5:3b

# ── Milvus ──────────────────────────────────────────────────
MILVUS_URI=http://IP-VPS-ANDA:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_TOKEN=
# Database Milvus tujuan. Korpus pasar modal: "megan_rag".
# Korpus lama ketenagalistrikan tetap di database "default".
MILVUS_DB=megan_rag
MILVUS_COLLECTION=megan_rag

# ── Observability (opsional) ────────────────────────────────
# Kosongkan jika tidak pakai Langfuse; sistem tetap berjalan.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Alerting (opsional, isi minimal satu kanal) ─────────────
# Kosongkan seluruhnya: alert hanya ke console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
GMAIL_WEBHOOK_URL=
EMAIL_SENDER=
EMAIL_RECEIVER=
EMAIL_APP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── OCR (opsional) ──────────────────────────────────────────
# Path binary tesseract jika tidak ada di PATH (PDF hasil scan).
TESSERACT_CMD=
